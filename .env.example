# APPLICATION
NODE_ENV=development

# DATABASE - @irctc/database
DATABASE_URL=postgresql://postgres:iamafzal@localhost:5432/irctc
DB_POOL_MAX=50

# LOGGER - @irctc/logger
LOG_LEVEL=debug
LOG_ENABLED=true
LOG_PRETTY=true
LOG_REDACT=true

# REDIS - @irctc/redis
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_MAX_RETRIES=3

# RABBITMQ
RABBITMQ_URL=amqp://irctc:irctc@localhost:5672

# AUTHENTICATION / AUTH SERVICE
JWT_ACCESS_SECRET=your-access-secret-key-minimum-32-characters
JWT_REFRESH_SECRET=your-refresh-secret-key-minimum-32-characters

# Access token lifetime
JWT_ACCESS_EXPIRE=15m

# Refresh token lifetime
JWT_REFRESH_EXPIRE=7d

# JWT verification
JWT_ISSUER=irctc-auth-service
JWT_AUDIENCE=irctc-api

# OAuth / Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SERVICES - PORTS
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=4001
USER_SERVICE_PORT=4002
STATION_SERVICE_PORT=4003
TRAIN_SERVICE_PORT=4004
ROUTE_SERVICE_PORT=4005
SEARCH_SERVICE_PORT=4006
SEAT_SERVICE_PORT=4007
BOOKING_SERVICE_PORT=4008
PAYMENT_SERVICE_PORT=4009
NOTIFICATION_SERVICE_PORT=4010

# SERVICES - INTERNAL URLs
GATEWAY_SERVICE_URL=http://api-gateway:3000
AUTH_SERVICE_URL=http://auth-service:4001
USER_SERVICE_URL=http://user-service:4002
STATION_SERVICE_URL=http://station-service:4003
TRAIN_SERVICE_URL=http://train-service:4004
ROUTE_SERVICE_URL=http://route-service:4005
SEARCH_SERVICE_URL=http://search-service:4006
SEAT_SERVICE_URL=http://seat-service:4007
BOOKING_SERVICE_URL=http://booking-service:4008
PAYMENT_SERVICE_URL=http://payment-service:4009
NOTIFICATION_SERVICE_URL=http://notification-service:4010

# SERVICE IDENTIFIERS
AUTH_SERVICE=AUTH_SERVICE
USER_SERVICE=USER_SERVICE
STATION_SERVICE=STATION_SERVICE
TRAIN_SERVICE=TRAIN_SERVICE
ROUTE_SERVICE=ROUTE_SERVICE
SEARCH_SERVICE=SEARCH_SERVICE
SEAT_SERVICE=SEAT_SERVICE
BOOKING_SERVICE=BOOKING_SERVICE
PAYMENT_SERVICE=PAYMENT_SERVICE
NOTIFICATION_SERVICE=NOTIFICATION_SERVICE

# THIRD-PARTY SERVICES

# SendGrid
SENDGRID_API_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# MIDDLEWARE - @irctc/middleware

# Request ID
REQUEST_ID_HEADER=X-Request-ID
# Request Timeout
REQUEST_TIMEOUT_MS=30000
# Rate Limiting
RATE_LIMIT_ENABLED=true

# General API
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=100

# Login / brute-force protection
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=8

# Registration / account creation
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_MAX=5

# Email-related actions
RATE_LIMIT_EMAIL_WINDOW_MS=3600000
RATE_LIMIT_EMAIL_MAX=5

# CORS
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true

# Express Proxy
TRUST_PROXY=false