node_modules/
.pnpm-store/
jspm_packages/

# Environment variables — never commit real secrets.
# The !.env.example line below keeps the template file tracked.
.env
.env.*
!.env.example
!.env.*.example

# Build output
dist/
build/
out/
.turbo/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test & coverage
coverage/
.nyc_output/

# Drizzle
# (schema.js and the migrations/ folder ARE tracked — this only
# catches drizzle-kit's local scratch state if it ever creates one)
packages/database/.drizzle/

# Docker
docker-compose.override.yml
*.pid

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Temp files
tmp/
temp/
*.tmp

# Secrets / certificates — never commit real keys
*.pem
*.key
*.crt
!infrastructure/nginx/*.example.crt